# Agent-X environment template
# This file lives inside the source folder and is safe to commit as an example.
# Copy it to `.env` and fill in real values when running outside the desktop app.

# Embedded PostgreSQL (default when running the Agent-X desktop app).
# The desktop app starts its own PostgreSQL on port 3335 and sets this automatically.
AGENTX_POSTGRES_CONNECTION_STRING=postgresql://agentx:agentx@127.0.0.1:3335/agentx

# Optional: override the web-api port
# AGENTX_PORT=3333

# ─────────────────────────────────────────────────────────────────────────────
# Observability (traces, logs, metrics)
# These are optional with sensible defaults. The runtime config (retention,
# capture_prompts, enabled) lives in the `observability.config` DB table and
# is managed via the Developer Tab in Settings or the /api/observability/config
# endpoint. The env vars below control low-level exporter/sampler behavior.
# ─────────────────────────────────────────────────────────────────────────────

# Fully disable observability (no tracer, no exporter, no sampler).
# AGENTX_OBS_ENABLED=true

# Span export batch size (number of spans per flush).
# AGENTX_OBS_BATCH_SIZE=512

# Span export flush interval in milliseconds.
# AGENTX_OBS_FLUSH_MS=5000

# Minimum log level for the durable log sink (debug|info|warn|error).
# AGENTX_OBS_LOG_LEVEL=info

# Metrics sampler interval in milliseconds.
# AGENTX_OBS_METRICS_INTERVAL_MS=15000

# Retention purger interval in milliseconds (default: 24h).
# AGENTX_OBS_PURGE_INTERVAL_MS=86400000

# Dedicated observability PostgreSQL pool size (separate from the app pool).
# AGENTX_OBS_PG_POOL_SIZE=2
